library ieee;
use ieee.std_logic_1164.all;
use ieee.numeric_std.all;

use work.recop_types.all;
use work.various_constants.all;
use work.TdmaMinTypes.all;

entity recop_top_tb is
end;

architecture sim of recop_top_tb is

    signal clk   : std_logic := '0';
    signal reset : std_logic := '1';
    signal init  : std_logic := '0';
    -- DE1-SoC KEY style:
    -- not pressed = 1
    -- pressed     = 0
    signal sip   : std_logic_vector(15 downto 0) := x"FFFF";
    signal sop   : std_logic_vector(15 downto 0);
    signal dpcr  : tdma_min_port;
    signal dprr  : bit_2;
    signal current_state_output : bit_4;

    constant CLK_PERIOD : time := 20 ns;
begin
    u_recop_top : entity work.recop_top
    port map(
        clk => clk,
        reset => reset,
        init => init,

        sip => sip,
        sop => sop,

        dpcr => dpcr,
        dprr => dprr,
        
        current_state_output => current_state_output
    );

        --------------------------------------------------------------------
    -- Clock generation
    --------------------------------------------------------------------
    clk_process : process
    begin
        while true loop
            clk <= '0';
            wait for CLK_PERIOD / 2;
            clk <= '1';
            wait for CLK_PERIOD / 2;
        end loop;
    end process;
        --------------------------------------------------------------------
    -- Stimulus
    --------------------------------------------------------------------
    stim_process : process
    begin
        ----------------------------------------------------------------
        -- Initial reset
        ----------------------------------------------------------------
        reset <= '1';
        init  <= '0';
        sip   <= x"FFFF";      -- no button pressed
        wait for 5 * CLK_PERIOD;

        reset <= '0';
        wait for 5 * CLK_PERIOD;

        ----------------------------------------------------------------
        -- Optional init pulse
        ----------------------------------------------------------------
        init <= '1';
        wait for CLK_PERIOD;
        init <= '0';
        wait for 5 * CLK_PERIOD;

        ----------------------------------------------------------------
        -- No peripheral command
        -- sip(3 downto 1) = "111"
        ----------------------------------------------------------------
        sip <= x"FFFF";
        wait for 5 * CLK_PERIOD;

        ----------------------------------------------------------------
        -- Simulate START command
        -- sip(3 downto 1) = "011"
        --
        -- Low nibble:
        -- bit3 bit2 bit1 bit0
        --  0    1    1    1  = 0x7
        ----------------------------------------------------------------
        sip <= x"FFF7";
        wait for 5 * CLK_PERIOD;

        ----------------------------------------------------------------
        -- Release button
        ----------------------------------------------------------------
        sip <= x"FFFF";
        wait for 5 * CLK_PERIOD;

        ----------------------------------------------------------------
        -- Simulate STOP command
        -- sip(3 downto 1) = "101"
        --
        -- bit3 bit2 bit1 bit0
        --  1    0    1    1 = 0xB
        ----------------------------------------------------------------
        sip <= x"FFFB";
        wait for 5 * CLK_PERIOD;

        ----------------------------------------------------------------
        -- Release button
        ----------------------------------------------------------------
        sip <= x"FFFF";
        wait for 5 * CLK_PERIOD;

        ----------------------------------------------------------------
        -- Simulate CLEAR command
        -- sip(3 downto 1) = "110"
        --
        -- bit3 bit2 bit1 bit0
        --  1    1    0    1 = 0xD
        ----------------------------------------------------------------
        sip <= x"FFFD";
        wait for 5 * CLK_PERIOD;

        ----------------------------------------------------------------
        -- Release button
        ----------------------------------------------------------------
        sip <= x"FFFF";
        wait for 10 * CLK_PERIOD;

        ----------------------------------------------------------------
        -- End simulation
        ----------------------------------------------------------------
        wait;
    end process;

end sim;
