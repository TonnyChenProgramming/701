ENTITY Correlation_ASP_Top_tb IS
END Correlation_ASP_Top_tb;

ARCHITECTURE sim OF Correlation_ASP_Top_tb IS

    constant CLK_PERIOD : time := 20 ns;

    signal clock : bit_1 := '0';
    signal reset : bit_1 := '0';
    signal init  : bit_1 := '0';

    signal dm_data_in : bit_16 := (others => '0');
    signal dm_wr_addr : bit_9  := (others => '0');
    signal dm_wren    : bit_1  := '0';

    signal calculate : bit_1 := '0';
    signal new_ave_data_addr : bit_9 := (others => '0');
    signal config_en : bit_1 := '0';
    signal correlation_window_n : bit_9 := (others => '0');
    signal offset_h : bit_16 := (others => '0');

    signal correlation : bit_36;
    signal correlation_rdy : bit_1;

BEGIN

    DUT : ENTITY work.Correlation_ASP_Top
        PORT MAP (
            clock => clock,
            init  => init,
            reset => reset,

            dm_data_in => dm_data_in,
            dm_wr_addr => dm_wr_addr,
            dm_wren    => dm_wren,

            calculate => calculate,
            new_ave_data_addr => new_ave_data_addr,
            config_en => config_en,
            correlation_window_n => correlation_window_n,
            offset_h => offset_h,

            correlation => correlation,
            correlation_rdy => correlation_rdy
        );

    clock_process : PROCESS
    BEGIN
        WHILE true LOOP
            clock <= '0';
            WAIT FOR CLK_PERIOD / 2;
            clock <= '1';
            WAIT FOR CLK_PERIOD / 2;
        END LOOP;
    END PROCESS;

    stim_proc : PROCESS
    BEGIN
        reset <= '1';
        WAIT FOR 3 * CLK_PERIOD;
        reset <= '0';

        WAIT FOR 2 * CLK_PERIOD;

        -- write RAM[0] = 1
        dm_wr_addr <= bit_9(to_unsigned(0, 9));
        dm_data_in <= bit_16(to_unsigned(1, 16));
        dm_wren <= '1';
        WAIT FOR CLK_PERIOD;
        dm_wren <= '0';

        WAIT FOR CLK_PERIOD;

        -- write RAM[1] = 2
        dm_wr_addr <= bit_9(to_unsigned(1, 9));
        dm_data_in <= bit_16(to_unsigned(2, 16));
        dm_wren <= '1';
        WAIT FOR CLK_PERIOD;
        dm_wren <= '0';

        WAIT FOR CLK_PERIOD;

        -- config
        correlation_window_n <= bit_9(to_unsigned(1, 9));
        offset_h <= bit_16(to_unsigned(0, 16));
        config_en <= '1';
        WAIT FOR CLK_PERIOD;
        config_en <= '0';

        WAIT FOR 2 * CLK_PERIOD;

        -- start calculation
        new_ave_data_addr <= bit_9(to_unsigned(2, 9));
        calculate <= '1';
        WAIT FOR CLK_PERIOD;
        calculate <= '0';

        WAIT FOR 30 * CLK_PERIOD;

        WAIT;
    END PROCESS;

END sim;